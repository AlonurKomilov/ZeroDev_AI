# .env.example - rename to .env and fill in your values for local development

# Set to "production" to enable production features
ENVIRONMENT=development

# Set to "True" for development features like debug mode
DEBUG=False

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=zerodev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# OpenAI API Key
OPENAI_API_KEY="your_openai_api_key_here"

# JWT Secret Key (generate a strong random key)
JWT_SECRET="your_jwt_secret_key_here"

# Encryption key for API keys (32-byte base64 encoded)
ENCRYPTION_KEY="3pQ-77B69QHIpjN7pZPeUriK25jxbvMBeKkOLlJjtjo="

# Owner emergency key for admin access
OWNER_EMERGENCY_KEY="your_owner_emergency_key_here"

# Admin TOTP secret (for 2FA, generate with: python -c "import pyotp; print(pyotp.random_base32())")
ADMIN_TOTP_SECRET="JBSWY3DPEHPK3PXP"

# Vault Configuration (for production)
VAULT_ADDR="http://127.0.0.1:8200"
VAULT_TOKEN="your_vault_token_here"
